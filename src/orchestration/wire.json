{
  "version": 1,
  "max_bytes": 1048576,
  "max_sequence": 4195328,
  "error_message": "Chat interrupted. Resume or discard the pending run.",
  "private_markers": ["bearer ", "sk-", "private key", "<think", "</think", "<analysis", "</analysis", "<system", "</system", "<developer", "</developer", "chain-of-thought", "chain of thought", "chain_of_thought", "system prompt", "hidden prompt", "api_key", "api-key", "api key", "password=", "password:", "access_token", "access-token", "access token", "secret=", "secret:"],
  "types": {
    "id": {"kind": "id"},
    "optional_id": {"kind": "nullable", "item": "id"},
    "bool": {"kind": "bool"},
    "version": {"kind": "int", "min": 1, "max": 1},
    "sequence": {"kind": "int", "min": 1, "max": 4195328},
    "checkpoint_sequence": {"kind": "int", "min": 1, "max": 4096},
    "attempt": {"kind": "int", "min": 0, "max": 4096},
    "retry": {"kind": "int", "min": 0, "max": 1},
    "depth": {"kind": "int", "min": 0, "max": 2},
    "agent_depth": {"kind": "int", "min": 0, "max": 4},
    "rank": {"kind": "int", "min": 1, "max": 128},
    "chunk": {"kind": "int", "min": 0, "max": 2147483647},
    "page": {"kind": "int", "min": 0, "max": 2147483647},
    "exchange": {"kind": "int", "min": 1, "max": 9007199254740991},
    "optional_exchange": {"kind": "nullable", "item": "exchange"},
    "score": {"kind": "number", "min": -1e308, "max": 1e308},
    "label": {"kind": "text", "min": 0, "max": 512},
    "query": {"kind": "text", "min": 1, "max": 4096},
    "answer": {"kind": "text", "min": 0, "max": 8192},
    "reply": {"kind": "text", "min": 1, "max": 8192},
    "delta": {"kind": "text", "min": 1, "max": 8192},
    "snippet": {"kind": "text", "min": 1, "max": 4096},
    "run_status": {"kind": "enum", "values": ["running", "interrupted", "completed", "failed", "discarded"]},
    "work_status": {"kind": "enum", "values": ["queued", "running", "waiting", "completed", "failed", "cancelled"]},
    "agent_kind": {"kind": "enum", "values": ["intake", "question", "finalizer"]},
    "finalizer": {"kind": "enum", "values": ["finalizer"]},
    "tool_name": {"kind": "enum", "values": ["retrieve_context", "add_question", "answer_question"]},
    "chat_mode": {"kind": "enum", "values": ["real", "mock"]},
    "warning_code": {"kind": "enum", "values": ["duplicate_question", "question_limit", "empty_evidence", "retrieval_failed", "question_failed", "handler_retry", "derived_index"]},
    "error_code": {"kind": "enum", "values": ["interrupted", "failed", "discarded", "invalid_stream"]},
    "error_message": {"kind": "enum", "values": ["Chat interrupted. Resume or discard the pending run."]},
    "ids": {"kind": "array", "item": "id", "max": 128, "unique": true},
    "question": {"kind": "object", "fields": {"question_id": "id", "text": "query", "parent_id": "optional_id", "depth": "depth", "status": "work_status", "answer": "answer", "evidence_ids": "ids"}},
    "agent": {"kind": "object", "fields": {"agent_id": "id", "kind": "agent_kind", "question_id": "optional_id", "parent_id": "optional_id", "depth": "agent_depth", "status": "work_status", "retry_count": "retry", "attempt": "attempt"}},
    "tool": {"kind": "object", "fields": {"tool_call_id": "id", "agent_id": "id", "attempt": "attempt", "tool_name": "tool_name", "question_id": "optional_id", "evidence_ids": "ids"}},
    "source": {"kind": "object", "fields": {"rank": "rank", "paper_id": "id", "chunk_index": "chunk", "filename": "label", "title": "label", "page": "page", "score": "score", "snippet": "snippet"}},
    "evidence": {"kind": "object", "fields": {"evidence_id": "id", "question_id": "optional_id", "source": "source"}},
    "questions": {"kind": "array", "item": "question", "max": 8, "key": "question_id"},
    "agents": {"kind": "array", "item": "agent", "max": 32, "key": "agent_id"},
    "tools": {"kind": "array", "item": "tool", "max": 256, "key": "tool_call_id"},
    "evidence_list": {"kind": "array", "item": "evidence", "max": 128, "key": "evidence_id"},
    "sources": {"kind": "array", "item": "source", "max": 35, "key": "rank"},
    "snapshot": {"kind": "object", "fields": {"checkpoint_sequence": "checkpoint_sequence", "status": "run_status", "exchange_id": "optional_exchange", "questions": "questions", "agents": "agents", "tools": "tools", "evidence": "evidence_list"}}
  },
  "envelope": {"version": "version", "session_id": "id", "run_id": "id", "turn_id": "id", "sequence": "sequence"},
  "events": {
    "snapshot": {"snapshot": "snapshot"},
    "agent_started": {"agent": "agent"},
    "agent_completed": {"agent": "agent"},
    "agent_retried": {"agent": "agent"},
    "tool_started": {"tool": "tool"},
    "tool_completed": {"tool": "tool"},
    "question_added": {"question": "question"},
    "question_status": {"question": "question"},
    "question_answered": {"question": "question"},
    "question_failed": {"question": "question"},
    "evidence": {"evidence": "evidence_list"},
    "warning": {"code": "warning_code"},
    "final_delta": {"agent_id": "id", "kind": "finalizer", "delta": "delta"},
    "done": {"exchange_id": "exchange", "reply": "reply", "chat_mode": "chat_mode", "indexed": "bool", "sources": "sources"},
    "error": {"code": "error_code", "message": "error_message", "resumable": "bool"}
  }
}