{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Research assistant",
  "version": "0.1.0",
  "identifier": "com.capstone.research-assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/backend/macos-arm64/capstone-cli": "backend/macos-arm64/capstone-cli"
    },
    "icon": [
      "icons/icon.png"
    ]
  }
}
