# Example environment for the capstone research assistant.
#
# Copy to `.env` and fill in a real key to enable real (non-mock) chat:
#     cp .env.example .env
#
# The bridge loads the NEAREST `.env` at or above the project root, so a key
# kept one level up (e.g. ../.env) is also picked up. Real `.env` files are
# gitignored; this `.env.example` is a safe, committable template — never put
# a real key in it.

# --- LLM API key (pick ONE) -------------------------------------------------
# OpenAI: uses https://api.openai.com/v1 and model gpt-4o-mini by default.
OPENAI_API_KEY=

# OpenRouter: when set (and OPENAI_API_KEY is empty) the chat/embedding base
# URL and default model automatically switch to OpenRouter.
OPENROUTER_API_KEY=

# --- Optional model / endpoint overrides ------------------------------------
# Explicit values below always win over the key-based defaults above.

# Chat model id (default: gpt-4o-mini for OpenAI, openai/gpt-5.4-mini for OpenRouter).
CAPSTONE_CHAT_MODEL=

# Chat endpoint base URL (default follows the key: OpenAI or OpenRouter).
CAPSTONE_CHAT_BASE_URL=

# Optional positive output-token budget. Empty means no application-imposed limit.
CAPSTONE_CHAT_MAX_TOKENS=

# Embedding model + endpoint (embeddings power chat-history search).
CAPSTONE_EMBED_MODEL=
CAPSTONE_EMBED_BASE_URL=

# Override the assistant's system prompt (optional).
CAPSTONE_SYSTEM_PROMPT=
